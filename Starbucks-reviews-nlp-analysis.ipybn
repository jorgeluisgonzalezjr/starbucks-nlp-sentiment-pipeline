      "source": [
        "import pandas as pd\n",
        "\n",
        "# Load the dataset\n",
        "df = pd.read_csv('starbucks_reviews_data.csv')\n",
        "\n",
        "# Drop both 'name' and 'Image_Links' at the same time!\n",
        "df.drop(columns=['name','Image_Links'], inplace=True)\n",
        "\n",
        "print(\"Cleaned Dataset Columns:\")\n",
        "print(df.columns.tolist())\n",
        "\n",
        "display(df.head())"
      ]
    },
