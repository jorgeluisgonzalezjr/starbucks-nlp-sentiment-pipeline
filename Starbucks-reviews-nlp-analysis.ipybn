    {
      "cell_type": "markdown",
      "source": [
        "Step 1 Tokenization : Chop up the sentences into individual words"
      ],
      "metadata": {
        "id": "xOMp2zBylxlV"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "#where we will store text\n",
        "list_of_tokens = []\n",
        "\n",
        "\n",
        "#column of reviews\n",
        "reviews = df['Review']\n",
        "for review in reviews:\n",
        "  review_string = str(review)\n",
        "  #tokenizing text\n",
        "  tokenized_text = word_tokenize(review_string)\n",
        "\n",
        "  list_of_tokens.append(tokenized_text)\n",
        "\n",
        "df['Tokenized_Words'] = list_of_tokens\n",
        "\n",
        "display(df[['Review', 'Tokenized_Words']].head(3))"
      ],
      "metadata": {
